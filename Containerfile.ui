# Multi-stage build for UI
FROM node:18-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY ui/package*.json ./
COPY ui/apps/portal/package*.json ./apps/portal/
COPY ui/packages/components/package*.json ./packages/components/

# Install dependencies
RUN npm ci

# Copy source code
COPY ui/ .

# Build the UI
RUN npm run build

# Final stage - unprivileged nginx
FROM nginxinc/nginx-unprivileged:1.29.0-alpine-slim

# Copy built UI files
COPY --from=builder /app/apps/portal/dist /usr/share/nginx/html

# Create nginx config for SPA
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    location / {
        root /usr/share/nginx/html;
        try_files \$uri \$uri/ /index.html;
    }
}
EOF

# Expose port
EXPOSE 8080

# Run nginx (already runs as non-root user nginx)
CMD ["nginx", "-g", "daemon off;"]